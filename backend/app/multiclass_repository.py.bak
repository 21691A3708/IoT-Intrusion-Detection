

def list_persisted_responses(
    connection,
    limit=50,
    offset=0,
    risk_level=None,
    predicted_family=None,
    status=None,
    source=None,
):

    conditions = []

    params = {
        "limit": limit,
        "offset": offset,
    }

    if risk_level is not None:

        conditions.append(
            "a.risk_level = :risk_level"
        )

        params["risk_level"] = risk_level

    if predicted_family is not None:

        conditions.append(
            "p.predicted_family = :predicted_family"
        )

        params["predicted_family"] = predicted_family

    if status is not None:

        conditions.append(
            "r.status = :status"
        )

        params["status"] = status

    if source is not None:

        conditions.append(
            "p.source = :source"
        )

        params["source"] = source

    where_clause = (
        "WHERE " + " AND ".join(conditions)
        if conditions
        else ""
    )

    base_query = """
        FROM multiclass.response_records r

        JOIN multiclass.risk_assessments a
            ON a.id = r.risk_assessment_id

        JOIN multiclass.predictions p
            ON p.id = a.prediction_id

        LEFT JOIN multiclass.incidents i
            ON i.risk_assessment_id = a.id
    """

    count_query = text(
        "SELECT COUNT(*) "
        + base_query
        + where_clause
    )

    total = connection.execute(
        count_query,
        params,
    ).scalar_one()

    query = text("""
        SELECT
            r.id AS response_id,
            p.id AS prediction_id,
            a.id AS risk_assessment_id,
            i.id AS incident_id,

            p.requested_device_identifier,
            p.predicted_label,
            p.predicted_family,
            p.prediction_confidence,
            p.calibrated_attack_probability,
            p.detection_status,
            p.model_version,
            p.source,

            a.risk_score,
            a.risk_level,
            a.recommended_action,

            r.status,
            r.containment_eligible,
            r.approval_granted,
            r.simulation_executed,
            r.real_network_action_executed,

            i.status AS incident_status,

            r.created_at,
            r.updated_at
    """
        + base_query
        + where_clause
        + """
        ORDER BY r.created_at DESC, r.id DESC
        LIMIT :limit
        OFFSET :offset
        """
    )

    records = []

    for row in connection.execute(
        query,
        params,
    ).mappings():

        item = dict(row)

        for key in (
            "response_id",
            "prediction_id",
            "risk_assessment_id",
            "incident_id",
        ):

            if item[key] is not None:

                item[key] = str(item[key])

        for key in ("created_at", "updated_at"):

            item[key] = item[key].isoformat()

        item["incident_created"] = (
            item["incident_id"] is not None
        )

        records.append(item)

    return {
        "total": total,
        "limit": limit,
        "offset": offset,
        "returned": len(records),
        "records": records,
    }
